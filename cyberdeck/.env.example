# cyberdeck/.env.example — copy to .env and fill in. NEVER commit .env.
# All values are for provisioning YOUR OWN device.

# SSH access to the cyberdeck (Termux sshd)
CYBERDECK_SSH_PORT=8022
# Your laptop's PUBLIC key (contents of ~/.ssh/id_ed25519.pub) — key auth only.
CYBERDECK_AUTHORIZED_KEY=

# Set to "yes" to skip the interactive authorization prompt (CI/emulator only).
CYBERDECK_AUTHORIZED=

# Extra Kali packages appended to the toolkit install (space-separated).
TOOLKIT_EXTRA=

# Emulator: override the throwaway HOME used by 'run-emulator.sh dry'.
CYBERDECK_EMU_HOME=
