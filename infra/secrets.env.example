# secrets.env — the ONE file of credentials the bootstrap ships to the box.
#
#   cp secrets.env.example secrets.env   # git-ignored; never commit it
#   $EDITOR secrets.env                  # fill only what you have; blanks are skipped
#
# bootstrap.sh reads this file (or the same names from your shell environment), copies
# it to the box as /opt/aurora/secrets.env (mode 600); SETUP.md §6 copies the values into
# each stack's .env. Provider tokens (HCLOUD_TOKEN, HOSTINGER_API_TOKEN…) stay on your phone.
# Anything left blank is simply not wired: add it later and re-run ./bootstrap.sh.

# --- Box ------------------------------------------------------------------------
# Where the server lives: hetzner (default: CX33 in Nuremberg) or hostinger. See SETUP.md §1.
VPS_PROVIDER=hetzner
# Hetzner Cloud API token (Read & Write): console.hetzner.com → project → Security → API tokens.
# Used by bootstrap.sh on your phone and by the Hetzner MCP; NOT copied to the box.
HCLOUD_TOKEN=
# The Hetzner MCP reads the same token under this name.
HETZNER_API_TOKEN=${HCLOUD_TOKEN}
# --- Only if VPS_PROVIDER=hostinger ---
# Hostinger API token: https://hpanel.hostinger.com/profile/api
# Only used from your phone/computer by bootstrap.sh: it is NOT copied to the box.
HOSTINGER_API_TOKEN=
# Plan, and months per bill (1 = monthly; 12/24 are cheaper but paid up front).
HOSTINGER_PLAN="KVM 2"
HOSTINGER_TERM=1
# Timezone for n8n and cron.
TZ=Australia/Melbourne
# Optional public hostname for n8n (e.g. n8n.example.com). Leave blank for tunnel-only
# access over SSH (http://localhost:5678) — the safe default until Cloudflare is set up.
N8N_DOMAIN=

# --- Model providers (feed the LiteLLM router + the CLI agents) -------------------
# Subscriptions (Claude Pro/Max, ChatGPT, Google AI Pro, SuperGrok, Cursor) mostly log in
# instead of using a key — see SUBSCRIPTIONS.md for which is which.
OPENROUTER_API_KEY=      # https://openrouter.ai/keys — free models, Grok Build, and fallbacks
ANTHROPIC_API_KEY=       # Claude Code + router general/code/reason + computer-use desktop
GEMINI_API_KEY=          # Gemini CLI (Google AI Studio key); the router reaches Gemini via OpenRouter
XAI_API_KEY=             # Grok CLI direct to xAI (else it goes through OpenRouter)
OPENAI_API_KEY=          # Codex CLI, OpenBot; LibreChat if you want OpenAI models there
KIMI_API_KEY=            # router `kimi-cheap` (Kimi Code Console key)
CURSOR_API_KEY=          # optional: Cursor CLI on the server (cursor.com/dashboard/api); uses your Cursor plan

HF_TOKEN=                # Hugging Face: hf-* router models + Hermes fallback (Inference Providers)

# --- Hermes Agent: chat gateways (stacks/hermes) — fill only what you use -----------
# Each platform also needs its *_ALLOWED_USERS line, or the bot won't answer anyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
SLACK_BOT_TOKEN=         # xoxb-…
SLACK_APP_TOKEN=         # xapp-… (Socket Mode)
SLACK_ALLOWED_USERS=
WHATSAPP_ALLOWED_USERS=  # digits with country code, e.g. 61412345678
COMPOSIO_CONSUMER_KEY=   # composio.dev → Connect → consumer key (1000+ app tools via MCP)
ZAPIER_MCP_TOKEN=        # mcp.zapier.com → server for "Other" client → Generate token (9,000+ apps)
GROQ_API_KEY=            # optional: faster cloud Whisper for voice notes (blank = free local Whisper)
GITHUB_PAT=              # GitHub MCP (Hermes + Claude Code): fine-grained PAT, least privilege
CONTEXT7_API_KEY=        # optional: Context7 docs MCP, higher limits

# --- Tailscale (stacks/tailscale) -----------------------------------------------
TS_AUTHKEY=              # login.tailscale.com → Settings → Keys (pre-approved)

# --- Apps (only needed for the app you switch on) ----------------------------------
INTELLIGENCE_API_KEY=    # OpenBot: the cpk-... key from `npx copilotkit@latest project select`
