# Hetzner Cloud — reproducible box (optional; Claude can also provision via the Hetzner MCP).
# Copy to main.tf, fill the variables, then: terraform init && terraform apply
#
# Provider docs: https://registry.terraform.io/providers/hetznercloud/hcloud/latest/docs

terraform {
  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.49"
    }
  }
}

variable "hcloud_token" {
  description = "Hetzner Cloud API token (scope one per Project = one client). Set via TF_VAR_hcloud_token, never commit."
  type        = string
  sensitive   = true
}

variable "ssh_public_key" {
  description = "Your SSH public key (ssh-ed25519 ...)."
  type        = string
}

variable "server_name" {
  type    = string
  default = "aurora-hub"
}

# Server type MUST be available in the chosen location:
#   - Singapore (sin) and US (ash/hil): AMD shared = CPX*, dedicated = CCX*.
#   - EU only (nbg1/fsn1/hel1): Intel shared = CX* AND Ampere ARM = CAX* (cheaper).
# Default = cx33 (4 vCPU / 8 GB, €8.49/mo before VAT, Sept 2026) in nbg1. Since the June 2026
# price rise the same 8 GB in Singapore (cpx32) costs ~5× more; CX/CAX are EU-only.
variable "server_type" {
  type    = string
  default = "cx33"
}

# nbg1 = Nuremberg (~300 ms to Australia: fine for bots/agents; mosh hides it for SSH).
# Others: fsn1/hel1 (EU), sin (Singapore, CPX/CCX only, much pricier), ash/hil (US).
variable "location" {
  type    = string
  default = "nbg1"
}

provider "hcloud" {
  token = var.hcloud_token
}

resource "hcloud_ssh_key" "default" {
  name       = "${var.server_name}-key"
  public_key = var.ssh_public_key
}

# Firewall: SSH + Tailscale only, same as bootstrap.sh. Drop the SSH rule once Tailscale works.
resource "hcloud_firewall" "web" {
  name = "${var.server_name}-fw"

  rule {
    direction  = "in"
    protocol   = "tcp"
    port       = "22"
    source_ips = ["0.0.0.0/0", "::/0"]
  }
  rule {
    direction  = "in"
    protocol   = "udp"
    port       = "41641" # Tailscale direct connections
    source_ips = ["0.0.0.0/0", "::/0"]
  }
}

resource "hcloud_server" "box" {
  name         = var.server_name
  server_type  = var.server_type
  image        = "ubuntu-24.04"
  location     = var.location
  ssh_keys     = [hcloud_ssh_key.default.id]
  firewall_ids = [hcloud_firewall.web.id]
  user_data    = file("${path.module}/cloud-init.yaml")

  public_net {
    ipv4_enabled = true
    ipv6_enabled = true
  }
}

output "server_ipv4" {
  value = hcloud_server.box.ipv4_address
}
