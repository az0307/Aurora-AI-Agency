#!/usr/bin/env bash
# aurora-secrets — fill infra/secrets.env from your Bitwarden vault (Bitwarden CLI, `bw`).
#
# One-time, in Bitwarden (app or vault.bitwarden.com): make a folder called "Aurora"
# and add one item per key. Item NAME = the variable name (e.g. OPENROUTER_API_KEY),
# the key goes in the item's PASSWORD (Login item) or NOTES (Secure note).
#
#   aurora-secrets check          # which keys the vault has / is missing (shows no values)
#   aurora-secrets fill           # write ~/aurora/infra/secrets.env (mode 600), then lock
#   aurora-secrets fill PATH      # write somewhere else
#
# The vault is unlocked only for this command and locked again at the end. Values are
# never printed. The server never sees your vault: bootstrap.sh ships only secrets.env.
set -uo pipefail
INFRA=${AURORA_INFRA:-$HOME/aurora/infra}
TEMPLATE="$INFRA/secrets.env.example"
FOLDER=${AURORA_BW_FOLDER:-Aurora}
cmd=${1:-check}; out=${2:-$INFRA/secrets.env}
for t in bw jq; do command -v $t >/dev/null || { echo "Missing $t — run: aurora-kit bitwarden" >&2; exit 1; }; done
[ -f "$TEMPLATE" ] || { echo "No $TEMPLATE (clone the repo to ~/aurora first)" >&2; exit 1; }

locked_by_us=0
unlock() {
  local st; st=$(bw status 2>/dev/null | jq -r .status)
  case "$st" in
    unauthenticated) echo "Log in to Bitwarden (email, master password, then 2FA):"; bw login >/dev/null || exit 1
                     BW_SESSION=$(bw unlock --raw) || exit 1 ;;
    locked)          BW_SESSION=$(bw unlock --raw) || exit 1 ;;
    unlocked)        : ;;
    *)               echo "Bitwarden CLI isn't working (status: ${st:-none})" >&2; exit 1 ;;
  esac
  export BW_SESSION; locked_by_us=1
  bw sync >/dev/null 2>&1 || true
}
cleanup() { [ $locked_by_us = 1 ] && bw lock >/dev/null 2>&1; }
trap cleanup EXIT

unlock
fid=$(bw list folders --search "$FOLDER" | jq -r --arg f "$FOLDER" '.[] | select(.name==$f) | .id' | head -1)
[ -n "$fid" ] || { echo "No Bitwarden folder named \"$FOLDER\". Create it and add items named like OPENROUTER_API_KEY." >&2; exit 1; }
items=$(bw list items --folderid "$fid")
keys=$(grep -oE '^[A-Z][A-Z0-9_]*=' "$TEMPLATE" | tr -d '=' | sort -u)
value_of() { printf '%s' "$items" | jq -r --arg k "$1" \
  '[.[] | select(.name==$k) | (.login.password // .notes // "")] | first // "" | gsub("[\r\n]+$";"")'; }

found=0; missing=""
for k in $keys; do
  if [ -n "$(value_of "$k")" ]; then found=$((found+1)); else missing="$missing $k"; fi
done
echo "Bitwarden folder \"$FOLDER\": $found of $(echo $keys | wc -w) keys found."
[ -n "$missing" ] && echo "Not in the vault (left empty):$missing"
[ "$cmd" = check ] && exit 0
[ "$cmd" = fill ] || { sed -n '2,12p' "$0"; exit 1; }

umask 077
tmp=$(mktemp "${out}.XXXX")
while IFS= read -r line || [ -n "$line" ]; do
  if [[ "$line" =~ ^([A-Z][A-Z0-9_]*)= ]]; then
    k=${BASH_REMATCH[1]}; v=$(value_of "$k")
    if [ -n "$v" ]; then printf '%s=%q\n' "$k" "$v"; else printf '%s\n' "$line"; fi   # keep the template default
  else printf '%s\n' "$line"; fi
done < "$TEMPLATE" > "$tmp"
mv "$tmp" "$out" && chmod 600 "$out"
echo "Wrote $out (mode 600). Next: ./bootstrap.sh --dry-run"
