# ~/.bashrc additions for Termux (append to your existing ~/.bashrc).
# Server shortcuts assume the box is on your tailnet as `aurora-01` (see ssh_config).

# Attach to (or create) the phone's own tmux session on every new Termux tab:
if command -v tmux >/dev/null && [ -z "$TMUX" ] && [ -z "$NO_TMUX" ]; then
  tmux new -A -s phone
fi

alias aurora='mosh aurora-01 -- tmux new -A -s main || ssh -t aurora-01 tmux new -A -s main'
alias ah='ssh -t aurora-01 "cd /opt/aurora/stacks/hermes && docker compose logs -f --tail 100 gateway"'   # Hermes logs
alias aps='ssh aurora-01 docker ps --format "table {{.Names}}\t{{.Status}}"'                              # what's running
alias arestart-hermes='ssh aurora-01 "cd /opt/aurora/stacks/hermes && docker compose restart gateway"'
alias ll='ls -alh'
alias update='pkg update && pkg upgrade -y'
export EDITOR=nano
