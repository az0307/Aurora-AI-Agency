{
  "mcpServers": {
    "playwright": {
      "type": "http",
      "url": "${PLAYWRIGHT_MCP_URL}"
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp@2.89.0"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "${N8N_API_URL}",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "composio": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp",
      "headers": { "x-consumer-api-key": "${COMPOSIO_CONSUMER_KEY}" }
    },
    "cua": {
      "command": "docker",
      "args": ["exec", "-i", "computer-cua", "cua-driver", "mcp", "--socket", "/home/agent/.cache/cua-driver/cua-driver.sock"]
    }
  }
}
