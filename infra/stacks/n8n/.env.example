# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=n8n

# --- n8n ---
# Pin the image to a specific n8n release; 1.x->2.x has breaking changes (2.0
# enables task runners by default). Use 'latest' only for throwaway boxes.
N8N_IMAGE_TAG=latest
N8N_DOMAIN=n8n.example.com
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=Australia/Melbourne

# Login gate = n8n's built-in OWNER ACCOUNT, created on first run in the UI.
# n8n removed N8N_BASIC_AUTH_* in v1.0, so there are no basic-auth vars to set.
# Keep n8n behind Cloudflare Access as the outer gate. To pre-provision the
# owner from env, see N8N_INSTANCE_OWNER_MANAGED_BY_ENV in the n8n docs.

# Stable across restarts — BACK THIS UP (losing it makes stored creds unreadable):
# generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-32-plus-random-hex

# Restrict from wildcard to your real domain(s) once live (Y.M.I open item):
N8N_CORS_ALLOW_ORIGIN=https://ymiroofing.com.au
