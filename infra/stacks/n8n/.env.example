# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=n8n

# --- n8n ---
N8N_DOMAIN=n8n.example.com
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=Australia/Melbourne

# Second auth gate behind Cloudflare Access:
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong

# Stable across restarts — BACK THIS UP (losing it makes stored creds unreadable):
# generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-32-plus-random-hex

# Restrict from wildcard to your real domain(s) once live (Y.M.I open item):
N8N_CORS_ALLOW_ORIGIN=https://ymiroofing.com.au
