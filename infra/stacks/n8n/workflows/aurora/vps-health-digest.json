{
  "id": "auroravpshealthd",
  "name": "vps-health-digest — nightly box check to Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 6 * * *"
            }
          ]
        }
      },
      "id": "n005",
      "name": "06:50 daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -320,
        -160
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://router-litellm-1:4000/health/liveliness",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "n006",
      "name": "Router alive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5678/healthz",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "n007",
      "name": "n8n alive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ text: \"🖥️ aurora-01 nightly: router=\" + ($('Router alive').item.json.statusCode === 200 ? 'up' : 'DOWN') + \", n8n=\" + ($('n8n alive').item.json.statusCode === 200 ? 'up' : 'DOWN') + \". Full check: run `aurora maintain report`.\" }) }}",
        "options": {}
      },
      "id": "n008",
      "name": "Digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -320,
        40
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_ALLOWED_USERS || '<YOUR_CHAT_ID>'}}",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "n009",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        0,
        40
      ]
    }
  ],
  "connections": {
    "06:50 daily": {
      "main": [
        [
          {
            "node": "Router alive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Router alive": {
      "main": [
        [
          {
            "node": "n8n alive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "n8n alive": {
      "main": [
        [
          {
            "node": "Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Digest": {
      "main": [
        [
          {
            "node": "Notify Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "aurora_note": "A light nightly heartbeat. For the deep check use aurora maintain report on the box."
  },
  "tags": []
}