    {
      "parameters": {
        "jsCode": "\nconst banned = ($json.blacklist || '').split(/\\r?\\n/).map(s=>s.trim().toLowerCase()).filter(Boolean);\nreturn items.filter(i=>{\n  const t=(i.json.topic||i.json.title||'').toLowerCase();\n  return !banned.some(b=>t.includes(b));\n});\n"
      },
