      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "position": [
        -200,
        -40
      ],
      "id": "httpRequest-txahfy3y",
      "name": "GitHub: Recent Commits",
      "notes": "per_page=100 covers typical single-repo daily volume; the default was 30. For repos exceeding 100 commits/day, enable n8n HTTP pagination to follow the GitHub 'Link' header (rel=next). alwaysOutputData ensures the count node still runs (count=0) when the response is an empty array."
    },
    {
      "parameters": {
        "jsCode": "// Aggregate the GitHub /commits response into ONE item with a total count.\n// n8n may surface the JSON array either as one item per commit or as a single\n// item whose json IS the array; handle both, and 0 for an empty result.\nconst items = $input.all();\nlet count = 0;\nif (items.length === 1 && Array.isArray(items[0].json)) {\n  count = items[0].json.length;\n} else {\n  count = items.filter(i => i.json && (i.json.sha || i.json.commit)).length;\n}\nreturn [{ json: { count } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        -40
      ],
      "id": "code-countcommits",
      "name": "Count Commits"
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "channel": "#yt-daily",
        "text": "=GitHub commits in last 24h: {{$json.count}}"
      },
