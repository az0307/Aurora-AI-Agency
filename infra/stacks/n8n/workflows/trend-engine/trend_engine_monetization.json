      "parameters": {
        "jsCode": "\n// Expect post rows with topic/platform/urls; join with affiliates by keyword.\nreturn items.map(i=>{\n  const topic = (i.json.topic||'').toLowerCase();\n  const platform = (i.json.platform||'').toLowerCase();\n  const baseUrl = i.json.link || i.json.url || '';\n  const utm = `?utm_source=${platform||'multi'}&utm_medium=social&utm_campaign=${encodeURIComponent(topic)}`;\n  const aff = i.json.affiliate || ''; // if pre-matched\n  return {json:{...i.json, monetizedLink: (baseUrl||'') + utm, affiliateLink: aff}};\n});\n"
      },
