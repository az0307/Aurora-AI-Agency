          {
            "type": "Slack",
            "config": {
              "channel": "#dev",
              "message": "🔧 {{$json.user}} pushed to {{$json.repo}}"
            }
          }
        ],
        "output": "Real-time notifications",
        "coverage": "All 37 repos"
      },
      {
        "id": 12,
        "name": "Automated Backup System",
        "category": "monitoring",
        "description": "Daily backups of all critical data",
        "trigger": "Cron: 0 2 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 2 * * *"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "backup",
              "databases": ["leads", "clients", "proposals"]
            }
          },
          {
            "type": "Google Drive",
            "config": {
              "operation": "upload",
              "folder": "Backups/{{$now.format('YYYY-MM-DD')}}"
            }
          },
          {
            "type": "AWS S3",
            "config": {
              "operation": "upload",
              "bucket": "backups",
              "encryption": "AES256"
            }
          },
          {
            "type": "Slack",
            "config": {
              "channel": "#ops",
              "message": "✅ Daily backup completed: {{$json.size}}"
            }
          }
        ],
        "output": "Daily backups",
        "retention": "90 days"
      },
      {
        "id": 13,
        "name": "Client Satisfaction Survey",
        "category": "client_management",
        "description": "Post-project satisfaction tracking",
        "trigger": "Project completion",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "project-complete"
            }
          },
          {
            "type": "Wait",
            "config": {
              "duration": "24 hours"
            }
          },
          {
            "type": "Typeform",
            "config": {
              "operation": "send_survey",
              "form": "client_satisfaction"
            }
          },
          {
            "type": "Wait",
            "config": {
              "duration": "7 days",
              "condition": "survey_completed === false"
            }
          },
          {
            "type": "Gmail",
            "config": {
              "template": "survey_reminder",
              "subject": "Quick feedback on our project?"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "insert",
              "table": "satisfaction_scores"
            }
          },
          {
            "type": "Switch",
            "config": {
              "condition": "{{$json.nps}} < 7",
              "route": "alert_manager"
            }
          }
        ],
        "output": "80% response rate",
        "avg_nps": "8.5/10"
      },
      {
        "id": 14,
        "name": "Slack to Task Automation",
        "category": "integration",
