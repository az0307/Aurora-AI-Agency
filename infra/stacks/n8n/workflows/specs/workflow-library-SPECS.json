{
  "n8n_workflow_library": {
    "version": "1.0",
    "total_workflows": 20,
    "categories": [
      "revenue_generation",
      "client_management",
      "content_creation",
      "monitoring",
      "integration"
    ],
    "workflows": [
      {
        "id": 1,
        "name": "AutoborosAI - Daily Lead Discovery",
        "category": "revenue_generation",
        "description": "Discovers 50-100 high-value freelance leads daily",
        "trigger": "Cron: 0 9 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 9 * * *",
              "timezone": "America/New_York"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "method": "GET",
              "url": "http://localhost:5000/api/discover-leads",
              "authentication": "none"
            }
          },
          {
            "type": "Function",
            "config": {
              "code": "return items.filter(item => item.json.score > 0.6);"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "insert",
              "table": "leads",
              "columns": "id, title, budget, score, discovered_at"
            }
          },
          {
            "type": "Slack",
            "config": {
              "channel": "#revenue",
              "message": "🎯 Discovered {{$json.count}} high-value leads!"
            }
          }
        ],
        "output": "50-100 leads/day",
        "revenue_impact": "$25K-$100K/mo"
      },
      {
        "id": 2,
        "name": "AutoborosAI - Proposal Generator",
        "category": "revenue_generation",
        "description": "Generates personalized proposals for high-value leads",
        "trigger": "Webhook or Schedule",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "generate-proposal",
              "method": "POST"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "method": "POST",
              "url": "http://localhost:5000/api/generate-proposal",
              "body": {
                "lead_id": "={{$json.lead_id}}",
                "template": "={{$json.template}}"
              }
            }
          },
          {
            "type": "Google Docs",
            "config": {
              "operation": "create",
              "title": "Proposal - {{$json.lead_title}}",
              "content": "={{$json.proposal_content}}"
            }
          },
          {
            "type": "Gmail",
            "config": {
              "operation": "send",
              "to": "={{$json.client_email}}",
              "subject": "Proposal for {{$json.project_title}}",
              "attachments": ["={{$json.pdf_url}}"]
            }
          }
        ],
        "output": "10-15 proposals/day",
        "revenue_impact": "30% win rate"
      },
      {
        "id": 3,
        "name": "Client Onboarding Automation",
        "category": "client_management",
        "description": "Complete new client onboarding sequence",
        "trigger": "Webhook (project won)",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "client-won",
              "method": "POST"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "insert",
              "table": "clients",
              "data": "={{$json}}"
            }
          },
          {
            "type": "Gmail",
            "config": {
              "template": "welcome_email",
              "to": "={{$json.client_email}}",
              "subject": "Welcome to [Your Company] - Let's Get Started!"
            }
          },
          {
            "type": "Slack",
            "config": {
              "channel": "#new-clients",
              "message": "🎉 New client onboarded: {{$json.client_name}}"
            }
          },
          {
            "type": "Notion",
            "config": {
              "operation": "create",
              "database": "clients",
              "properties": {
                "name": "={{$json.client_name}}",
                "project_value": "={{$json.budget}}",
                "status": "Active"
              }
            }
          },
          {
            "type": "Schedule Trigger",
            "config": {
              "delay": "1 day",
              "action": "send_project_kickoff_email"
            }
          }
        ],
        "output": "Automated client setup",
        "time_saved": "2 hours/client"
      },
      {
        "id": 4,
        "name": "Content Distribution Network",
        "category": "content_creation",
        "description": "Publish content across all platforms simultaneously",
        "trigger": "Manual or Webhook",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "publish-content"
            }
          },
          {
            "type": "OpenAI",
            "config": {
              "operation": "optimize_for_platform",
              "platforms": ["twitter", "linkedin", "medium"]
            }
          },
          {
            "type": "Twitter",
            "config": {
              "operation": "tweet",
              "content": "={{$json.twitter_version}}"
            }
          },
          {
            "type": "LinkedIn",
            "config": {
              "operation": "post",
              "content": "={{$json.linkedin_version}}"
            }
          },
          {
            "type": "Medium",
            "config": {
              "operation": "publish",
              "title": "={{$json.title}}",
              "content": "={{$json.medium_version}}"
            }
          },
          {
            "type": "WordPress",
            "config": {
              "operation": "create_post",
              "status": "publish"
            }
          }
        ],
        "output": "Multi-platform publishing",
        "time_saved": "1 hour/post"
      },
      {
        "id": 5,
        "name": "System Health Monitor",
        "category": "monitoring",
        "description": "Monitors all services and alerts on issues",
        "trigger": "Cron: */5 * * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "*/5 * * * *"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "method": "GET",
              "url": "http://localhost:5000/api/health"
            }
          },
          {
            "type": "Switch",
            "config": {
              "rules": [
                {
                  "condition": "{{$json.status}} === 'healthy'",
                  "route": "success"
                },
                {
                  "condition": "{{$json.status}} === 'degraded'",
                  "route": "warning"
                },
                {
                  "condition": "{{$json.status}} === 'down'",
                  "route": "critical"
                }
              ]
            }
          },
          {
            "type": "Slack",
            "config": {
              "channel": "#alerts",
              "message": "🚨 CRITICAL: {{$json.service}} is down!",
              "route": "critical"
            }
          }
        ],
        "output": "99.9% uptime",
        "alerts": "Immediate notification"
      },
      {
        "id": 6,
        "name": "Email Inbox Automation",
        "category": "client_management",
        "description": "Auto-categorize and respond to emails",
        "trigger": "Gmail webhook",
        "nodes": [
          {
            "type": "Gmail Trigger",
            "config": {
              "watch": "inbox",
              "filter": "is:unread"
            }
          },
          {
            "type": "OpenAI",
            "config": {
              "operation": "categorize",
              "categories": ["urgent", "proposal_request", "support", "spam"]
            }
          },
          {
            "type": "Switch",
            "config": {
              "rules": [
                {"condition": "urgent", "route": "urgent_handler"},
                {"condition": "proposal_request", "route": "proposal_gen"},
                {"condition": "support", "route": "support_ticket"},
                {"condition": "spam", "route": "archive"}
              ]
            }
          },
          {
            "type": "Gmail",
            "config": {
              "operation": "reply",
              "template": "={{$json.template}}",
              "route": "urgent_handler"
            }
          }
        ],
        "output": "100% email coverage",
        "time_saved": "3 hours/day"
      },
      {
        "id": 7,
        "name": "Social Media Engagement Bot",
        "category": "content_creation",
        "description": "Auto-engage with relevant posts and comments",
        "trigger": "Cron: 0 */2 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 */2 * * *"
            }
          },
          {
            "type": "Twitter",
            "config": {
              "operation": "search",
              "query": "AI automation OR freelance automation",
