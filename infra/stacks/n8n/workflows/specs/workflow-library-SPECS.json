        "usage": "50+ tasks/week"
      },
      {
        "id": 15,
        "name": "Meeting Notes Automation",
        "category": "client_management",
        "description": "Auto-transcribe and summarize meetings",
        "trigger": "Zoom meeting ends",
        "nodes": [
          {
            "type": "Zoom Trigger",
            "config": {
              "event": "meeting.ended"
            }
          },
          {
            "type": "Zoom",
            "config": {
              "operation": "download_recording"
            }
          },
          {
            "type": "OpenAI Whisper",
            "config": {
              "operation": "transcribe"
            }
          },
