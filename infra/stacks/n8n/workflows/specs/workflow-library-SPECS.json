            }
          }
        ],
        "output": "Automated notes",
        "time_saved": "30 min/meeting"
      },
      {
        "id": 16,
        "name": "Price Change Monitor",
        "category": "monitoring",
        "description": "Track product/service prices across web",
        "trigger": "Cron: 0 */6 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 */6 * * *"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "urls": ["target_urls_array"]
            }
          },
          {
            "type": "Playwright",
            "config": {
              "action": "extract_price",
              "selector": ".price, [data-price]"
            }
          },
          {
            "type": "Function",
            "config": {
              "code": "const priceChange = currentPrice - previousPrice;\nconst percentChange = (priceChange / previousPrice) * 100;\nreturn {priceChange, percentChange};"
            }
          },
          {
            "type": "Switch",
            "config": {
              "condition": "Math.abs({{$json.percentChange}}) > 5",
              "route": "alert"
            }
          },
          {
            "type": "Slack",
            "config": {
              "message": "💰 Price alert: {{$json.product}} {{$json.percentChange > 0 ? 'increased' : 'decreased'}} by {{Math.abs($json.percentChange)}}%"
            }
          }
        ],
        "output": "6 checks/day",
        "savings": "$500+/month"
      },
      {
        "id": 17,
        "name": "Content Calendar Automation",
        "category": "content_creation",
        "description": "Plan, create, and schedule content automatically",
        "trigger": "Cron: 0 6 * * 1",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 6 * * 1"
            }
          },
          {
            "type": "OpenAI",
            "config": {
              "operation": "generate_content_ideas",
              "count": 7,
              "topics": ["AI", "automation", "freelancing"]
            }
          },
          {
            "type": "Loop",
            "config": {
              "items": "={{$json.ideas}}"
            }
          },
          {
            "type": "OpenAI",
            "config": {
              "operation": "write_post",
              "length": "medium"
            }
          },
          {
            "type": "Notion",
            "config": {
              "operation": "create_page",
              "database": "content_calendar",
              "status": "Ready to Publish"
            }
          }
        ],
        "output": "7 posts/week",
        "time_saved": "5 hours/week"
      },
      {
        "id": 18,
        "name": "API Usage Monitor",
        "category": "monitoring",
        "description": "Track API usage and costs across all services",
        "trigger": "Cron: 0 0 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 0 * * *"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "endpoints": [
                "brave_api_usage",
                "openai_api_usage",
                "github_api_usage"
              ]
            }
          },
          {
            "type": "Function",
            "config": {
              "code": "// Calculate costs and usage percentages\nreturn apis.map(api => ({\n  name: api.name,\n  usage: api.requests,\n  limit: api.limit,\n  percentage: (api.requests / api.limit) * 100,\n  cost: api.requests * api.cost_per_request\n}));"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "insert",
              "table": "api_usage_history"
            }
          },
          {
            "type": "Switch",
            "config": {
              "condition": "{{$json.percentage}} > 80",
              "route": "warning"
            }
          },
          {
            "type": "Slack",
            "config": {
              "message": "⚠️ {{$json.name}} API at {{$json.percentage}}% usage"
            }
          }
        ],
        "output": "Daily cost tracking",
        "cost_savings": "$200+/month"
      },
      {
        "id": 19,
        "name": "Lead Scoring & Enrichment",
        "category": "revenue_generation",
        "description": "Enrich leads with company data and score",
        "trigger": "New lead webhook",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "new-lead"
            }
          },
          {
            "type": "Clearbit",
            "config": {
              "operation": "enrich",
              "email": "={{$json.email}}"
            }
          },
          {
            "type": "LinkedIn",
            "config": {
              "operation": "get_company",
              "company": "={{$json.company}}"
            }
          },
          {
            "type": "Function",
            "config": {
              "code": "// Calculate lead score\nlet score = 0;\nif (companySize > 50) score += 20;\nif (revenue > 1000000) score += 30;\nif (industry === 'technology') score += 15;\nif (jobTitle.includes('CEO')) score += 25;\nreturn {score, ...leadData};"
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "update",
              "table": "leads",
              "set": {
                "enriched": true,
                "score": "={{$json.score}}",
                "company_data": "={{$json}}"
              }
            }
          },
          {
            "type": "Switch",
            "config": {
              "condition": "{{$json.score}} > 70",
              "route": "hot_lead"
            }
          },
          {
            "type": "Slack",
