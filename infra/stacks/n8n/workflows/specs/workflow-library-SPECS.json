      {
        "id": 11,
        "name": "GitHub Repository Monitor",
        "category": "monitoring",
        "description": "Track all GitHub activity across repos",
        "trigger": "GitHub webhook",
        "nodes": [
          {
            "type": "GitHub Trigger",
            "config": {
              "events": ["push", "pull_request", "issue"]
