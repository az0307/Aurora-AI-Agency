            }
          },
          {
            "type": "OpenAI",
            "config": {
              "operation": "generate_reply",
              "tone": "professional",
              "length": "short"
            }
          },
          {
            "type": "Twitter",
            "config": {
              "operation": "reply",
              "content": "={{$json.reply}}"
            }
          }
        ],
        "output": "50-100 engagements/day",
        "reach": "10K+ impressions/month"
      },
      {
        "id": 8,
        "name": "Invoice & Payment Automation",
        "category": "client_management",
        "description": "Generate invoices and track payments",
        "trigger": "Milestone completion",
        "nodes": [
          {
            "type": "Webhook",
            "config": {
              "path": "milestone-complete"
            }
          },
          {
            "type": "QuickBooks",
            "config": {
              "operation": "create_invoice",
              "customer": "={{$json.client_id}}",
              "amount": "={{$json.milestone_amount}}"
            }
          },
          {
            "type": "Gmail",
            "config": {
              "operation": "send",
              "template": "invoice_email",
              "attachments": ["={{$json.invoice_pdf}}"]
            }
          },
          {
            "type": "Wait",
            "config": {
              "duration": "7 days"
            }
          },
          {
            "type": "QuickBooks",
            "config": {
              "operation": "check_payment_status"
            }
          },
          {
            "type": "Switch",
            "config": {
              "condition": "{{$json.paid}} === false",
              "route": "send_reminder"
            }
          }
        ],
        "output": "Automated billing",
        "payment_rate": "95% on-time"
      },
      {
        "id": 9,
        "name": "Competitor Intelligence Tracker",
        "category": "monitoring",
        "description": "Track competitor pricing, features, and content",
        "trigger": "Cron: 0 8 * * *",
        "nodes": [
          {
            "type": "Schedule Trigger",
            "config": {
              "rule": "0 8 * * *"
            }
          },
          {
            "type": "HTTP Request",
            "config": {
              "method": "GET",
              "urls": [
                "https://competitor1.com/pricing",
                "https://competitor2.com/features"
              ]
            }
          },
          {
            "type": "Puppeteer",
            "config": {
              "action": "scrape",
              "selectors": {
                "pricing": ".price",
                "features": ".feature-list"
              }
            }
          },
          {
            "type": "Postgres",
            "config": {
              "operation": "insert",
              "table": "competitor_intel"
            }
          },
          {
            "type": "Function",
            "config": {
              "code": "// Detect price changes\nif (previousPrice !== currentPrice) {\n  return {alert: true, change: currentPrice - previousPrice};\n}"
            }
          },
          {
            "type": "Slack",
            "config": {
              "channel": "#intel",
              "condition": "={{$json.alert}}",
              "message": "🔍 Competitor price change detected!"
            }
          }
        ],
        "output": "Daily intel reports",
        "insights": "Strategic advantage"
      },
      {
