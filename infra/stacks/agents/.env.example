# Copy to .env (git-ignored). NEVER commit real keys.
# Pin the OpenHands release you tested here (see project releases). Keep SANDBOX_IMAGE's
# tag matched to it. Leaving these at `latest` is only OK on a throwaway lab box.
OPENHANDS_TAG=latest
SANDBOX_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:latest
LLM_MODEL=anthropic/claude-sonnet-5
# Leave blank to enter the key in the UI instead of baking it into the container:
LLM_API_KEY=
