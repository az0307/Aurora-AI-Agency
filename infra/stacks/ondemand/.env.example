# Copy to .env (git-ignored). NEVER commit real secrets.
# Only the profile(s) you actually start need their vars set.

# browser profile
BROWSER_TOKEN=change-me-random

# storage profile (MinIO)
MINIO_ROOT_USER=aurora
MINIO_ROOT_PASSWORD=change-me-strong

# scratch profile (throwaway Postgres)
SCRATCH_PG_PASSWORD=change-me-strong

# translate profile (LibreTranslate) — all optional, sensible defaults in compose.
# Limit loaded language pairs to save RAM/disk (comma-separated ISO codes; empty = all):
LT_LOAD_ONLY=en,es,fr,de,zh
# LT_DISABLE_WEB_UI=false
# LT_API_KEYS=false

# stt profile (whisper-asr-webservice) — all optional, defaults in compose.
# ASR_ENGINE=faster_whisper
# ASR_MODEL=base        # tiny|base|small|medium|large-v3 (bigger = slower on CPU)
