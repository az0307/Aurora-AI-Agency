# LiteLLM omni-router config — ONE endpoint over OpenRouter, Hugging Face, Anthropic,
# Kimi and Gemini, with fallback chains. Copy to config.yaml.
# Docs: https://docs.litellm.ai/docs/proxy/configs
# Secrets come from the environment (os.environ/…) — NEVER hard-code keys here.
#
# Every model id below was checked against the live OpenRouter / Hugging Face model
# lists in 2026-09. Free (:free) models ROTATE — re-check before relying on one:
#   https://openrouter.ai/models?max_price=0      https://router.huggingface.co/v1/models
#
# What agents call — CURATED BY JOB. Each chain is ordered best → fallback: the first
# model is the one we'd pick for that job; the rest only answer when it's down,
# rate-limited or erroring. Model ids + prices checked against OpenRouter 2026-09-24.
#
#   JOB            ALIAS         CHAIN (best → fallback)                                   DATA
#   everyday       general       Claude Sonnet 5 → GPT-5.6 Sol → Kimi Code → DeepSeek V4.1  paid-only, PII-safe
#   everyday, $0   general-free  Nemotron 3 Ultra → Inkling → Qwen3.8-27B → Gemma 4 → free   NON-sensitive only
#   coding         code          Claude Sonnet 5 → Grok Build → Kimi K2.7 Code → DeepSeek Pro paid-only
#   coding, $0     code-free     North Mini Code → Laguna S 2.1 → Qwen3.8-27B → Nemotron    NON-sensitive only
#   hard thinking  reason        Claude Opus 5.5 → GPT-5.6 Sol → Kimi K3 → DeepSeek Pro     paid-only
#   cheap bulk     fast          DeepSeek V4.1 Flash → MiniMax M3 → Gemini 3.8 Flash → Qwen  paid-only
#   images/video   vision        Gemini 3.8 Flash → Claude Sonnet 5 → GPT-5.6 Sol           paid-only
#   web answers    search        Perplexity Sonar Pro → Sonar                                paid-only
#   deep research  research      Sonar Deep Research → Sonar Reasoning Pro → Sonar Pro       paid-only
#   Nous models    hermes        Hermes 4 405B → HF Hermes 3 70B → DeepSeek V4.1            paid-only
#
# Older names still work and run the same chain as their job alias:
#   auto = general · auto-free = general-free · auto-code = code · auto-cheap = fast
#   auto-search = search
# They are separate entries on purpose: a LiteLLM model_group_alias does NOT carry
# the target's fallback chain (tested against litellm 1.8x — see README).
#
# Every free model in a chain supports tool calling (agents need it). Uncensored
# models are in no chain: call them by name.
# Any entry below can also be called directly by its model_name.

model_list:
  # ---- Anthropic (paid, direct) ----------------------------------------------
  - model_name: claude-primary
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: claude-opus
    litellm_params:
      model: anthropic/claude-opus-5-5
      api_key: os.environ/ANTHROPIC_API_KEY

  # ---- Kimi Code (subscription, OpenAI-compatible) ---------------------------
  # NOT the Moonshot Open Platform — keys/endpoints are not interchangeable.
  - model_name: kimi-cheap
    litellm_params:
      model: openai/kimi-for-coding
      api_base: https://api.kimi.com/coding/v1
      api_key: os.environ/KIMI_API_KEY

  # ---- OpenRouter (paid) -----------------------------------------------------
  - model_name: grok-build          # xAI's coding model
    litellm_params:
      model: openrouter/x-ai/grok-build-0.1
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: grok
    litellm_params:
      model: openrouter/x-ai/grok-4.7
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: hermes-405b         # Nous Hermes 4
    litellm_params:
      model: openrouter/nousresearch/hermes-4-405b
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: deepseek-flash      # very cheap, strong general model
    litellm_params:
      model: openrouter/deepseek/deepseek-v4.1-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: kimi-code-or        # Kimi Code via OpenRouter (no Kimi subscription needed)
    litellm_params:
      model: openrouter/moonshotai/kimi-k2.7-code
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: gemini-flash        # Gemini 3.8 Flash: 1M context, reads images/video/audio
    litellm_params:
      model: openrouter/google/gemini-3.8-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: gpt                 # OpenAI GPT-5.6 Sol (pay-per-use; your ChatGPT plan is separate)
    litellm_params:
      model: openrouter/openai/gpt-5.6-sol
      api_key: os.environ/OPENROUTER_API_KEY
  # ---- Perplexity (web-search-grounded answers, via OpenRouter) ---------------
  - model_name: perplexity-sonar          # fast search answers, cheapest
    litellm_params:
      model: openrouter/perplexity/sonar
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: perplexity-sonar-pro      # deeper search, more sources
    litellm_params:
      model: openrouter/perplexity/sonar-pro
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: perplexity-reasoning      # search + step-by-step reasoning
    litellm_params:
      model: openrouter/perplexity/sonar-reasoning-pro
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: perplexity-research       # multi-step deep research report (slow, pricier)
    litellm_params:
      model: openrouter/perplexity/sonar-deep-research
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- DeepSeek / Kimi / GLM / MiniMax / Qwen (via OpenRouter) ---------------
  - model_name: deepseek-pro
    litellm_params:
      model: openrouter/deepseek/deepseek-v4-pro
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: kimi-k3
    litellm_params:
      model: openrouter/moonshotai/kimi-k3
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: glm                       # Zhipu GLM-5.3
    litellm_params:
      model: openrouter/z-ai/glm-5.3
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: glm-flash
    litellm_params:
      model: openrouter/z-ai/glm-5.3-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: minimax                   # MiniMax M3
    litellm_params:
      model: openrouter/minimax/minimax-m3
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: qwen-max
    litellm_params:
      model: openrouter/qwen/qwen3.8-max-0902
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: qwen-flash
    litellm_params:
      model: openrouter/qwen/qwen3.8-flash
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- UNCENSORED / creative-writing models ----------------------------------
  # Call these BY NAME only. None of them is in any fallback chain, so no request can
  # fall through to an uncensored model by accident. Provider terms still apply: legal
  # adult/creative content is fine; anything illegal is not, on any provider.
  - model_name: dolphin             # Dolphin-Mistral 24B Venice edition — general assistant, no refusals
    litellm_params:
      model: openrouter/cognitivecomputations/dolphin-mistral-24b-venice-edition
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: cydonia             # TheDrummer Cydonia 24B — creative writing / roleplay
    litellm_params:
      model: openrouter/thedrummer/cydonia-24b-v4.1
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: skyfall             # TheDrummer Skyfall 36B (32k context)
    litellm_params:
      model: openrouter/thedrummer/skyfall-36b-v2
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: unslopnemo          # TheDrummer UnslopNemo 12B — cheap, 1M context
    litellm_params:
      model: openrouter/thedrummer/unslopnemo-12b
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: euryale             # Sao10K Euryale 70B (Llama 3.3) — long-form creative
    litellm_params:
      model: openrouter/sao10k/l3.3-euryale-70b
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: magnum              # Anthracite Magnum v4 72B (pricier, 32k context)
    litellm_params:
      model: openrouter/anthracite-org/magnum-v4-72b
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: lunaris             # Sao10K Lunaris 8B — near-free ($0.04/M in), 8k context
    litellm_params:
      model: openrouter/sao10k/l3-lunaris-8b
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: mythomax            # Gryphe MythoMax 13B — classic, very cheap, 8k context
    litellm_params:
      model: openrouter/gryphe/mythomax-l2-13b
      api_key: os.environ/OPENROUTER_API_KEY

  - model_name: openrouter-auto     # OpenRouter picks + falls back server-side
    litellm_params:
      model: openrouter/openrouter/auto
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- OpenRouter FREE (rate-limited; may train on inputs — no client PII) ----
  - model_name: free-auto           # self-updating: a retired :free id can't break it
    litellm_params:
      model: openrouter/openrouter/free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-nemotron-super
    litellm_params:
      model: openrouter/nvidia/nemotron-3-super-120b-a12b:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-qwen
    litellm_params:
      model: openrouter/qwen/qwen3.8-27b:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-gemma
    litellm_params:
      model: openrouter/google/gemma-4-31b-it:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-coder
    litellm_params:
      model: openrouter/cohere/north-mini-code:free
      api_key: os.environ/OPENROUTER_API_KEY

  - model_name: free-nemotron-ultra # NVIDIA Nemotron 3 Ultra 550B, 1M context — best free generalist
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-inkling        # Thinking Machines Inkling, 1M context
    litellm_params:
      model: openrouter/thinkingmachines/inkling:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-laguna         # Poolside Laguna S 2.1 — coding
    litellm_params:
      model: openrouter/poolside/laguna-s-2.1:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-glm            # 32k context only
    litellm_params:
      model: openrouter/z-ai/glm-5.2:free
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- Hugging Face Inference Providers (OpenAI-compatible router) -----------
  # Pay-per-use with a monthly free credit on the HF account; one HF_TOKEN covers all.
  - model_name: hf-qwen
    litellm_params:
      model: openai/Qwen/Qwen3.8-27B
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-deepseek
    litellm_params:
      model: openai/deepseek-ai/DeepSeek-V4.1-Flash
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-gpt-oss
    litellm_params:
      model: openai/openai/gpt-oss-120b
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-kimi
    litellm_params:
      model: openai/moonshotai/Kimi-K2.6
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-hermes
    litellm_params:
      model: openai/NousResearch/Hermes-3-Llama-3.1-70B
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN

  - model_name: hf-deepseek-r1
    litellm_params:
      model: openai/deepseek-ai/DeepSeek-R1
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-kimi-k3
    litellm_params:
      model: openai/moonshotai/Kimi-K3
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-glm
    litellm_params:
      model: openai/zai-org/GLM-5.3
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-minimax
    litellm_params:
      model: openai/MiniMaxAI/MiniMax-M3
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-qwen-coder
    litellm_params:
      model: openai/Qwen/Qwen3-Coder-Next
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN

  - model_name: hf-stheno           # UNCENSORED — Sao10K Stheno 8B (call by name only)
    litellm_params:
      model: openai/Sao10K/L3-8B-Stheno-v3.2
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN
  - model_name: hf-lunaris          # UNCENSORED — Sao10K Lunaris 8B (call by name only)
    litellm_params:
      model: openai/Sao10K/L3-8B-Lunaris-v1
      api_base: https://router.huggingface.co/v1
      api_key: os.environ/HF_TOKEN

  # ---- FREE local models on this box (needs ../ollama running) ----------------
  # $0 per token: they run on the server's own CPU via Ollama, over the shared
  # `aurora-llm` Docker network. Slow on CPU (a few tokens/sec) and only ONE is held in
  # memory at a time — sized for an 8 GB box. Pull before first use, e.g.:
  #   docker compose -f ../ollama/docker-compose.yml exec ollama ollama pull dolphin3:8b
  # UNCENSORED — call by name only; never in a fallback chain.
  - model_name: local-dolphin       # Dolphin 3 8B (Llama 3.1), ~5 GB
    litellm_params:
      model: ollama_chat/dolphin3:8b
      api_base: http://ollama:11434
  - model_name: local-dolphin-mistral   # Dolphin-Mistral 7B, ~4 GB
    litellm_params:
      model: ollama_chat/dolphin-mistral:7b
      api_base: http://ollama:11434
  - model_name: local-qwen3-abliterated # Qwen3 8B abliterated (refusals removed), ~5 GB
    litellm_params:
      model: ollama_chat/huihui_ai/qwen3-abliterated:8b
      api_base: http://ollama:11434
  - model_name: local-gemma3-abliterated # Gemma 3 4B abliterated, ~3 GB, fastest
    litellm_params:
      model: ollama_chat/huihui_ai/gemma3-abliterated:4b
      api_base: http://ollama:11434

  # ---- JOB ALIASES — what agents call (first hop of each curated chain) -----
  - model_name: general       # everyday default — paid-only
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: general-free  # everyday, $0 — non-sensitive only
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: code          # coding
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: code-free     # coding, $0 — non-sensitive only
    litellm_params:
      model: openrouter/cohere/north-mini-code:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: reason        # hard problems, planning, reviews
    litellm_params:
      model: anthropic/claude-opus-5-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: fast          # cheap bulk work
    litellm_params:
      model: openrouter/deepseek/deepseek-v4.1-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: vision        # screenshots, photos, video, audio
    litellm_params:
      model: openrouter/google/gemini-3.8-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: search        # live web + citations (Sonar has no tool calling)
    litellm_params:
      model: openrouter/perplexity/sonar-pro
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: research      # multi-step research report; slow, pricier
    litellm_params:
      model: openrouter/perplexity/sonar-deep-research
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: hermes        # Nous Hermes 4
    litellm_params:
      model: openrouter/nousresearch/hermes-4-405b
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- Older names, kept so existing agents / workflows keep working ---------
  - model_name: auto          # = general
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: auto-free     # = general-free
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: auto-code     # = code
    litellm_params:
      model: anthropic/claude-sonnet-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: auto-cheap    # = fast
    litellm_params:
      model: openrouter/deepseek/deepseek-v4.1-flash
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: auto-search   # = search
    litellm_params:
      model: openrouter/perplexity/sonar-pro
      api_key: os.environ/OPENROUTER_API_KEY

litellm_settings:
  drop_params: true             # tolerate params a given provider doesn't accept
  request_timeout: 600
  num_retries: 2                # retry the SAME model on transient errors first…
  # …then walk these chains left→right until one succeeds.
  # SAFETY: every chain WITHOUT "-free" in its name is PAID-ONLY, so client PII never
  # lands on a free / data-training tier. Free models appear only in general-free,
  # code-free and auto-free — non-sensitive work only, by contract (see README).
  fallbacks:
    # job aliases
    - general: ["gpt", "kimi-cheap", "deepseek-flash"]
    - general-free: ["free-inkling", "free-qwen", "free-gemma", "free-auto"]
    - code: ["grok-build", "kimi-code-or", "deepseek-pro"]
    - code-free: ["free-laguna", "free-qwen", "free-nemotron-ultra"]
    - reason: ["gpt", "kimi-k3", "deepseek-pro"]
    - fast: ["minimax", "gemini-flash", "qwen-flash"]
    - vision: ["claude-primary", "gpt"]
    - search: ["perplexity-sonar"]
    - research: ["perplexity-reasoning", "perplexity-sonar-pro"]
    - hermes: ["hf-hermes", "deepseek-flash"]
    # older names (same chains)
    - auto: ["gpt", "kimi-cheap", "deepseek-flash"]
    - auto-free: ["free-inkling", "free-qwen", "free-gemma", "free-auto"]
    - auto-code: ["grok-build", "kimi-code-or", "deepseek-pro"]
    - auto-cheap: ["minimax", "gemini-flash", "qwen-flash"]
    - auto-search: ["perplexity-sonar"]
    # single models called by name
    - claude-primary: ["gpt", "kimi-cheap", "deepseek-flash"]
    - claude-opus: ["claude-primary", "gpt"]
    - grok-build: ["kimi-code-or", "claude-primary"]
    - deepseek-pro: ["hf-deepseek", "deepseek-flash"]
    - kimi-k3: ["hf-kimi-k3", "kimi-code-or"]
    - glm: ["hf-glm", "glm-flash"]
    - minimax: ["hf-minimax"]
    - qwen-max: ["hf-qwen", "qwen-flash"]
  # If a request is too big for a model's context window, retry on a bigger one:
  context_window_fallbacks:
    - free-qwen: ["free-nemotron-ultra"]
    - hermes: ["claude-primary"]
    - grok-build: ["gemini-flash"]

router_settings:
  routing_strategy: simple-shuffle
  allowed_fails: 3              # per model, before it's benched
  cooldown_time: 30             # seconds a repeatedly-failing model sits out

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY   # clients authenticate with this; must start with sk-
