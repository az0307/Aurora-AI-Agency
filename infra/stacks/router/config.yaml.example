# LiteLLM omni-router config — ONE endpoint over many providers, with fallbacks.
# Copy to config.yaml. Docs: https://docs.litellm.ai/docs/proxy/configs
# Secrets come from the environment (os.environ/…) — NEVER hard-code keys here.
#
# Two aliases are what agents actually call:
#   auto       → quality-first: best paid model, degrade to free ON FAILURE only
#   auto-free  → cost-first:     free model first, escalate to paid ON FAILURE only
# The `fallbacks:` block below defines the drop-through order for each.

model_list:
  # ---- Quality tier (paid) ---------------------------------------------------
  - model_name: claude-primary
    litellm_params:
      # set to your CURRENT Anthropic API model id (verify at docs.anthropic.com)
      model: anthropic/claude-sonnet-4-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: kimi-cheap
    litellm_params:
      # Kimi CODE API (subscription), OpenAI-compatible. This is NOT the Moonshot
      # Open Platform — its keys/endpoints are not interchangeable. Docs: kimi.com/code/docs
      model: openai/kimi-for-coding
      api_base: https://api.kimi.com/coding/v1
      api_key: os.environ/KIMI_API_KEY
      # (For general, non-code Kimi via the Moonshot Open Platform instead:
      #  model: openai/kimi-k2-<ver>, api_base: https://api.moonshot.ai/v1.)

  # ---- Free tier (OpenRouter ":free" variants) -------------------------------
  # These ROTATE and are rate-limited. Confirm the current free list before use:
  #   https://openrouter.ai/models?max_price=0
  - model_name: free-auto
    litellm_params:
      # OpenRouter's self-updating FREE router (slug openrouter/free) — picks a
      # currently-available free model, so a single retired :free id can't break the
      # chain. (deepseek-r1:free was retired — this avoids pinning one volatile slug.)
      model: openrouter/openrouter/free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-llama-70b
    litellm_params:
      model: openrouter/meta-llama/llama-3.3-70b-instruct:free
      api_key: os.environ/OPENROUTER_API_KEY
  - model_name: free-qwen-72b
    litellm_params:
      model: openrouter/qwen/qwen-2.5-72b-instruct:free
      api_key: os.environ/OPENROUTER_API_KEY
  # OpenRouter's own auto-router — lets OpenRouter pick + fall back server-side.
  - model_name: openrouter-auto
    litellm_params:
      model: openrouter/openrouter/auto
      api_key: os.environ/OPENROUTER_API_KEY

  # ---- Gemini free tier (Google AI Studio key) -------------------------------
  - model_name: gemini-flash
    litellm_params:
      model: gemini/gemini-2.0-flash
      api_key: os.environ/GEMINI_API_KEY

  # ---- Router aliases the agents call ---------------------------------------
  - model_name: auto            # quality-first entrypoint
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: auto-free       # cost-first entrypoint (NON-sensitive workloads only)
    litellm_params:
      model: openrouter/openrouter/free
      api_key: os.environ/OPENROUTER_API_KEY

litellm_settings:
  drop_params: true             # tolerate params a given provider doesn't accept
  request_timeout: 600
  num_retries: 2                # retry the SAME model on transient errors first…
  # …then walk these chains left→right until one succeeds.
  # SAFETY: `auto` and `claude-primary` are PAID-ONLY so client PII never lands on a
  # free/data-training tier. Free models live ONLY under `auto-free`, which is for
  # non-sensitive workloads by contract (see AGENTS.md / the stack README).
  fallbacks:
    - auto: ["kimi-cheap"]
    - auto-free: ["free-llama-70b", "free-qwen-72b", "kimi-cheap"]
    - claude-primary: ["kimi-cheap"]
  # If a request exceeds a model's context window, retry on a bigger one:
  context_window_fallbacks:
    - free-llama-70b: ["free-auto", "claude-primary"]

router_settings:
  routing_strategy: simple-shuffle
  allowed_fails: 3              # per model, before it's benched
  cooldown_time: 30            # seconds a repeatedly-failing model sits out

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY   # clients authenticate with this; must start with sk-

# NOTE: exact placement of fallbacks/num_retries (litellm_settings vs
# router_settings) has shifted across LiteLLM versions. If a chain seems ignored,
# check the docs for the version you pinned and move the key accordingly.
