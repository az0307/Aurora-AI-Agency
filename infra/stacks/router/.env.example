# Omni-router (LiteLLM) secrets — copy to .env, fill with REAL keys.
# NEVER commit .env (only this .example). config.yaml reads these via os.environ/…

# Master key clients use to talk to the router (must start with sk-). Generate one:
#   python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-REPLACE_ME

# --- Upstream provider keys (set only the ones you actually use) ---
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  — unlocks the :free models
ANTHROPIC_API_KEY=       # quality tier (claude-primary / auto)
MOONSHOT_API_KEY=        # Kimi K2 cheap tier (kimi-cheap)
GEMINI_API_KEY=          # Google AI Studio free tier (gemini-flash)

# --- OPTIONAL: admin UI + virtual keys + spend tracking (needs the DB service) ---
# Uncomment router-db in docker-compose.yml, then set these:
# DATABASE_URL=postgresql://litellm:CHANGE_ME@router-db:5432/litellm
# STORE_MODEL_IN_DB=True
# ROUTER_DB_PASSWORD=CHANGE_ME
