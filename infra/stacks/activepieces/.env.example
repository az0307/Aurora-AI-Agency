# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.

# --- Public URL (the Cloudflare hostname you route to this box) ---
AP_FRONTEND_URL=https://automate.example.com

# --- Secrets — generate these before the first boot ---
# AP_ENCRYPTION_KEY must be 16 bytes as 32 hex chars:  openssl rand -hex 16
# Changing it after data exists makes stored connections unreadable — BACK IT UP.
AP_ENCRYPTION_KEY=change-me-32-hex-chars
# AP_JWT_SECRET — any long random string:  openssl rand -hex 32
AP_JWT_SECRET=change-me-64-plus-random-hex

# --- Postgres ---
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces
AP_POSTGRES_PASSWORD=change-me-strong

# --- Execution / misc (optional; defaults live in compose) ---
# UNSANDBOXED (default here) suits a single trusted box; SANDBOXED needs privileged: true
# AP_EXECUTION_MODE=UNSANDBOXED
# AP_TELEMETRY_ENABLED=false
