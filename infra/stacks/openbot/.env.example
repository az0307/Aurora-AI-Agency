OPENBOT_IMAGE=ghcr.io/copilotkit/openbot:v0.0.15
OPENBOT_HOST_PORT=3020

INTELLIGENCE_API_KEY=
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai

KEY_ENCRYPTION_KEY=
OPENAI_API_KEY=
# Leave OPENAI_API_KEY blank to go through the router. stacks-up.sh joins openbot to the
# `aurora-llm` network and sets OPENAI_BASE_URL=http://litellm:4000/v1 — reach the router by
# its service name on that shared Docker network, NOT via the docker0 bridge IP (172.17.0.1),
# which isn't stable and isn't how the stacks are wired.
# OPENAI_BASE_URL=http://litellm:4000/v1

OPENBOT_SINGLE_USER=true
# Usage telemetry to CopilotKit: off by default (docker-compose.yml). false = opt back in.
COPILOTKIT_TELEMETRY_DISABLED=true
TRUSTED_ORIGINS=http://127.0.0.1:3020,http://localhost:3020
OPENBOT_PUBLIC_URL=http://127.0.0.1:3020
OPENBOT_APP_URL=http://127.0.0.1:3020

PORT=3001
SERVER_PORT=3001
EMBEDDED_POSTGRES=on
TZ=Australia/Melbourne
