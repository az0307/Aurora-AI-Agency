# Hermes secrets — copy to data/.env (NOT this directory). NEVER commit real values.
# Put comments on their OWN line: Hermes reads `KEY=  # note` as the value "# note".
# Only fill the platforms you want; an empty token just leaves that platform off.

# --- Brain: the LiteLLM router on this box ---------------------------------------
# Same value as LITELLM_MASTER_KEY in ../router/.env
ROUTER_API_KEY=sk-REPLACE_ME
# Needed for pictures and video (image_gen / video_gen), and the direct fallback if
# the router is down. Same key as the router's.
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Composio: 1000+ apps (Gmail, Notion, GitHub, HubSpot, …) over MCP ------------
# composio.dev → Connect → create a consumer key (sent as x-consumer-api-key).
COMPOSIO_CONSUMER_KEY=

# --- Zapier: 9,000+ apps via your Zapier account (MCP) ---------------------------
# mcp.zapier.com → New server → client "Other" → Connect tab → Generate token.
ZAPIER_MCP_TOKEN=

# --- More MCP tools (optional) ---------------------------------------------------
# github.com/settings/personal-access-tokens/new (fine-grained)
GITHUB_PAT=
# optional, context7.com/dashboard
CONTEXT7_API_KEY=

# --- Voice notes (Whisper). Blank = free local Whisper on this box. -------------
# Optional faster cloud Whisper: console.groq.com/keys, then stt.provider: "groq".
GROQ_API_KEY=

# --- Who may talk to the bot. KEEP THIS false. ------------------------------------
# With it false, only the users listed per platform below get a reply.
GATEWAY_ALLOW_ALL_USERS=false

# --- Telegram (easiest; start here) ----------------------------------------------
# @BotFather → /newbot → token. Your numeric user id: message @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# chat id for scheduled/cron messages (optional)
TELEGRAM_HOME_CHANNEL=

# --- Discord ---------------------------------------------------------------------
# discord.com/developers → New Application → Bot → token; enable MESSAGE CONTENT intent.
# User id: Settings → Advanced → Developer Mode, then right-click yourself → Copy ID.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
# in servers, only answer when @mentioned
DISCORD_REQUIRE_MENTION=true

# --- Slack (Socket Mode — no public URL) -----------------------------------------
# Generate the app manifest with:  docker exec -it hermes hermes gateway setup  (pick Slack)
# xoxb-…
SLACK_BOT_TOKEN=
# xapp-… (Socket Mode app-level token)
SLACK_APP_TOKEN=
# Slack member ids, e.g. U0123ABCD
SLACK_ALLOWED_USERS=

# --- WhatsApp --------------------------------------------------------------------
# Option A (quick, personal number): built-in WhatsApp Web bridge. Pair once with
#   docker exec -it hermes hermes whatsapp     → scan the QR in WhatsApp → Linked devices
# Unofficial: small risk of the number being restricted. Use a spare number, not a client's.
WHATSAPP_ENABLED=false
# phone numbers, digits only with country code: 61412345678
WHATSAPP_ALLOWED_USERS=
# Option B (official, for business): WhatsApp Business Cloud API. Needs a Meta app and a
# PUBLIC webhook URL (Cloudflare Tunnel or Tailscale Funnel). See README.md.
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_APP_SECRET=
# WHATSAPP_CLOUD_VERIFY_TOKEN=
# WHATSAPP_CLOUD_ALLOWED_USERS=
# WHATSAPP_CLOUD_WEBHOOK_PORT=8095   # default 8090 collides with Beszel (monitoring) on this host
