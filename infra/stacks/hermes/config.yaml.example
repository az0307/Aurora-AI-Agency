# Hermes Agent config — copy to data/config.yaml (next to data/.env).
# Full reference: the upstream cli-config.yaml.example (NousResearch/hermes-agent).
# ${VARS} are read from data/.env.

_config_version: 46   # matches upstream cli-config.yaml.example (2026-09); `hermes doctor --fix` migrates later versions

# --- Brain: the LiteLLM router on this box --------------------------------------
# All model choice, ordering and fallbacks live in ../router/config.yaml, curated by
# JOB (best model first, then fallbacks). Hermes just asks the router for a job alias.
# Default is `general` — PAID-ONLY (Claude Sonnet 5 → GPT-5.6 → Kimi → DeepSeek)
# because chat messages can contain client details and free tiers may train on
# inputs. Switch per chat with /model <alias>.
model:
  default: "general"
  provider: custom
  base_url: "http://127.0.0.1:4000/v1"
  api_key: "${ROUTER_API_KEY}"

# /model <name> in any chat switches to one of these. Each is a curated chain.
model_aliases:
  general:   { model: general,      provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # everyday, paid-only (default)
  free:      { model: general-free, provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # everyday, $0 — non-sensitive only
  code:      { model: code,         provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Claude Sonnet 5 → Grok Build → Kimi Code → DeepSeek Pro
  code-free: { model: code-free,    provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # $0 coding — non-sensitive only
  reason:    { model: reason,       provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Claude Opus 5.5 → GPT-5.6 → Kimi K3 (hard problems)
  fast:      { model: fast,         provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # DeepSeek Flash → MiniMax → Gemini Flash (cheap bulk)
  vision:    { model: vision,       provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Gemini 3.8 Flash → Claude → GPT (images, video, audio)
  search:    { model: search,       provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Perplexity: live web + citations
  research:  { model: research,     provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Perplexity deep research report (slow)
  hermes:    { model: hermes,       provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # Nous Hermes 4 — no tool calling, so with tools on DeepSeek answers
  uncensored: { model: uncensored-agent, provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # fewer refusals, CAN use tools (Euryale 70B). Never client data.
  uncensored-free: { model: uncensored-free, provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }  # $0 on this box (needs ../ollama). Never client data.
  grok:      { model: grok,         provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }
  opus:      { model: claude-opus,  provider: custom, base_url: "http://127.0.0.1:4000/v1", key_env: ROUTER_API_KEY }
  # On your SuperGrok subscription (no API spend). One-time login on the box:
  #   docker exec -it hermes hermes auth add xai-oauth --no-browser
  # HTTP 403 after login = xAI restricts some SuperGrok tiers; use `grok`/`code` instead.
  supergrok:       { model: grok-4.6,       provider: xai-oauth }
  supergrok-build: { model: grok-build-0.1, provider: xai-oauth }
  # ChatGPT plan: run `docker exec -it hermes hermes model` → "ChatGPT or Codex Subscription".

# Side jobs Hermes runs in the background, each on the router alias that fits it
# (instead of burning the main model). `curator` is the weekly skill-library tidy-up.
auxiliary:
  vision:          { model: vision,  base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}" }
  compression:     { model: fast,    base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}" }
  title_generation: { model: fast,   base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}" }
  curator:         { model: fast,    base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}", timeout: 600 }
  goal_judge:      { model: general, base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}" }
  approval:        { model: general, base_url: "http://127.0.0.1:4000/v1", api_key: "${ROUTER_API_KEY}" }

# Curator: keeps the skills the agent writes for itself tidy. Prunes unused ones
# (archived, never deleted) and, with consolidate on, merges near-duplicates on the
# cheap `fast` chain. `hermes curator status` / `/curator` in chat.
curator:
  enabled: true
  consolidate: true
  interval_hours: 168
  backup: { enabled: true, keep: 3 }

# If the router itself is down, go straight to the providers (keys in data/.env).
# Paid models only, same PII rule as `auto`.
fallback_providers:
  - provider: openrouter
    model: deepseek/deepseek-v4.1-flash
  - provider: huggingface
    model: deepseek-ai/DeepSeek-V4.1-Flash

# --- Shell tool + long/background work ----------------------------------------------
# "local" = commands run inside the hermes container (no Docker socket, no host access).
# `timeout` caps ONE foreground command; long jobs run as background processes
# (the agent starts them with background=true and polls them), so they aren't cut off.
terminal:
  backend: "local"
  cwd: "/opt/data/workspace"
  timeout: 180

agent:
  max_turns: 500           # tool calls per task before it stops and reports
  gateway_timeout: 7200    # a chat task only times out after 2 h with NO activity

cron:
  catch_up_missed: true    # run jobs missed while the box was rebooting

# Approvals for risky shell commands. `smart` = a model auto-approves low-risk
# commands, blocks clearly dangerous ones, and asks you only when unsure.
# Unrestricted: send /yolo in a chat (that session only), or set mode: off to make
# it permanent. The agent is still fenced inside its container either way.
approvals:
  mode: smart
  timeout: 300
  cron_mode: deny          # background jobs never run a dangerous command unasked

# --- Web, browser, computer use ---------------------------------------------------
# Web search/extract works with no key (Hermes rotates free tiers). For
# unthrottled search add a key, e.g. TAVILY_API_KEY or FIRECRAWL_API_KEY in data/.env.
web:
  cache_ttl_minutes: 20

browser:
  record_sessions: false
  inactivity_timeout: 300

# The bot's own Linux desktop ("Bot Screen") for computer_use + a visible browser.
# Needs the -desktop image (HERMES_TAG=latest-desktop in .env) and more RAM; it
# starts on first use and stops itself after 30 idle minutes.
bot_desktop:
  geometry: "1280x800"
  auto_start: true
  min_free_memory_mb: 1200
  idle_stop_minutes: 30

# Tools per chat app. `computer_use` adds desktop control (only works with the
# -desktop image); drop it from a line to take that ability away on that app.
platform_toolsets:
  cli: [hermes-cli, computer_use]
  telegram: [hermes-telegram, computer_use]
  discord: [hermes-discord]
  whatsapp: [hermes-whatsapp]
  slack: [hermes-slack]

# --- Plugins (all opt-in; `hermes plugins list` shows what's installed) ----------------
#   disk-cleanup       tidies temp files the agent made, at the end of each session
#   security-guidance  warns when the agent writes risky code (secrets, eval, SQL…)
# More: `docker exec -it hermes hermes plugins search <word>` → install → enable.
plugins:
  enabled:
    - disk-cleanup
    - security-guidance

# --- Spoken replies ------------------------------------------------------------------
# Send /voice tts in Telegram to get answers back as voice bubbles (free Edge voices).
tts:
  provider: "edge"
  edge:
    voice: "en-AU-NatashaNeural"   # or en-AU-WilliamNeural

# --- Pictures and video ("make an image of…", "make a 6 second video of…") ---------------
# Both go through OpenRouter with OPENROUTER_API_KEY from data/.env. Files land in
# data/cache/images and data/cache/videos and are sent back in the chat.
# Change the model any time: `docker exec -it hermes hermes tools` → Image/Video generation,
# or just say "use gpt-image-2.5-flare" in the request. Prices: phones/kit/data/models.tsv.
image_gen:
  provider: openrouter
  model: bytedance-seed/seedream-4.5      # ~4¢/image, good all-rounder
  openrouter:
    resolution: 2K
video_gen:
  provider: openrouter
  model: google/veo-3.1-lite              # cheapest with sound: 3–8¢ per second

# --- Bitwarden Secrets Manager (optional) ------------------------------------------------
# Instead of pasting keys into data/.env, keep them in a Bitwarden Secrets Manager
# PROJECT that only this server can read (a "machine account"). Your personal vault is
# never on the server. Setup: docker exec -it hermes hermes secrets bitwarden setup
secrets:
  bitwarden:
    enabled: false
    project_id: ""
    server_url: ""          # https://vault.bitwarden.eu for EU accounts

# --- Tools over MCP ----------------------------------------------------------------
mcp_servers:
  # Composio Connect: one MCP server fronting 1000+ apps (Gmail, Notion, GitHub,
  # HubSpot, Google Sheets, …). Headless auth via a consumer key — no browser needed.
  # The first time you ask for an app, Composio replies with a link to authorize that
  # app's account; open it on your phone/laptop.
  composio:
    url: "https://connect.composio.dev/mcp"
    headers:
      x-consumer-api-key: "${COMPOSIO_CONSUMER_KEY}"
    lazy: true          # don't connect until a Composio tool is actually used

  # Zapier MCP: 9,000+ apps through your own Zapier account (your existing Zaps' app
  # connections are reused). Create a server for "Other client" at mcp.zapier.com →
  # Generate token → ZAPIER_MCP_TOKEN in data/.env. Add/remove actions at mcp.zapier.com.
  zapier:
    url: "https://mcp.zapier.com/api/v1/connect"
    headers:
      Authorization: "Bearer ${ZAPIER_MCP_TOKEN}"
    lazy: true

  # Current library/API docs (works without a key; CONTEXT7_API_KEY raises limits).
  context7:
    url: "https://mcp.context7.com/mcp"
    headers:
      CONTEXT7_API_KEY: "${CONTEXT7_API_KEY}"
    lazy: true

  # Hugging Face Hub: search/read models, datasets, Spaces, papers.
  huggingface:
    url: "https://huggingface.co/mcp"
    headers:
      Authorization: "Bearer ${HF_TOKEN}"
    lazy: true

  # GitHub's official hosted MCP: repos, PRs, issues, Actions. Use a fine-grained PAT
  # limited to the repos/permissions you want the bot to have.
  github:
    url: "https://api.githubcopilot.com/mcp/"
    headers:
      Authorization: "Bearer ${GITHUB_PAT}"
    lazy: true

  # Playwright browser (../computer stack): the agent opens pages, clicks, fills
  # forms, screenshots, saves PDFs. Logins persist in that stack's profile.
  playwright:
    url: "http://127.0.0.1:8931/mcp"
    lazy: true

  # Desktop Commander: files, search/replace edits, long-running terminal sessions
  # with live output. Runs INSIDE this container (same fence as the shell tool).
  desktop-commander:
    command: "npx"
    args: ["-y", "@wonderwhy-er/desktop-commander@0.2.51"]
    timeout: 600
    connect_timeout: 180   # the first start downloads it with npx (can take >30 s)
    lazy: true

# --- Voice: send a voice note in Telegram / WhatsApp / Discord / Slack ------------------
# Transcribed with Whisper, then handled like a typed message ("voice commands").
# "local" = faster-whisper ON THIS BOX: free, private (audio never leaves the server).
# It installs itself onto the data volume on the first voice note (~150 MB model).
# Want faster/more accurate? set GROQ_API_KEY in data/.env and provider: "groq"
# (Whisper large-v3-turbo, a fraction of a cent per minute).
stt:
  enabled: true
  provider: "local"
  language: "en"
  local:
    model: "base"                  # tiny | base | small (better, ~2x slower on CPU)
    unload_after_idle_seconds: 300 # free the RAM 5 min after the last voice note
  groq:
    model: "whisper-large-v3-turbo"
