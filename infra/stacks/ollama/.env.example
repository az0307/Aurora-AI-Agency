# Copy to .env (git-ignored). NEVER commit real secrets.
# Ollama itself needs no secrets — these are tunables with sane defaults in compose.

# How long a model stays resident after its last request (e.g. 5m, 30m, 1h, or -1 to keep):
OLLAMA_KEEP_ALIVE=5m
# Max models held in memory at once (raise only if you have the RAM/VRAM):
OLLAMA_MAX_LOADED_MODELS=1

# --- open-webui profile ("ui") only ---
# Keep auth ON so the chat UI isn't open behind Access (defense in depth):
WEBUI_AUTH=true
