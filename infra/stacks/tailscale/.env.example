# Copy to .env (git-ignored). NEVER commit a real key.
# login.tailscale.com → Settings → Keys → Generate auth key.
# Tick "Pre-approved"; leave "Reusable" off for a single box. Keys expire (90 days max) but
# the node stays logged in after first use — the key is only needed to join.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=aurora-01
